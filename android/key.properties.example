# Copiar a android/key.properties (NO commitear) y rellenar.
# Generar el keystore una vez con:
#   keytool -genkey -v -keystore ~/keystores/nfiles-release.jks \
#     -alias nfiles -keyalg RSA -keysize 2048 -validity 10000
storeFile=/home/usuario/keystores/nfiles-release.jks
storePassword=CAMBIA_ESTA_CONTRASEÑA
keyAlias=nfiles
keyPassword=CAMBIA_ESTA_CONTRASEÑA
